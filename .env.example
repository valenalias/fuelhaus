SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
JWT_SECRET=fuelhaus_jwt_2025_secret
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sincronización con FuelHaus OS (ver fuelhaus-os-sync.js) — si cualquiera
# de las dos falta, la sincronización se omite (logueada, no bloquea el
# pago del cliente).
FUELHAUS_OS_INGEST_URL=https://operating-system.example.vercel.app
FUELHAUS_OS_INGEST_TOKEN=...

# Cron diario de reconciliación de suscripciones (ver subscription-reconcile.js
# y vercel.json) — sin esta variable, GET /api/cron/reconcile-subscriptions
# rechaza cualquier llamada, nunca corre "abierto". Vercel manda este mismo
# valor solo en las llamadas programadas del cron (Authorization: Bearer).
CRON_SECRET=...
